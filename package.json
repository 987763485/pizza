{
  "name": "pizza",
  "version": "1.0.0",
  "private": true,
  "description": "Pizza — 本地优先的多智能体协作工作台",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify.sh",
    "check:package": "node scripts/check-package-metadata.mjs",
    "package:mac": "npm run check:package && npm run build && electron-builder --mac dmg zip --publish never",
    "package:win": "npm run check:package && npm run build && electron-builder --win nsis zip --publish never",
    "package:linux": "npm run check:package && npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^3.6.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "i18next": "^25.10.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-nice-avatar": "^1.5.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0",
  "author": "Pizza",
  "homepage": "https://github.com/987763485/pizza",
  "desktopName": "Pizza"
}
